# Copiar a .env y ajustar. Todo es opcional: lo que quede vacío usa el valor por defecto.

# ── General ───────────────────────────────────────────────────────────────────
# Zona horaria del equipo que escanea (los scripts escriben hora local).
LAN_TZ=America/Santiago

# ── Red ───────────────────────────────────────────────────────────────────────
# Vacío = se detecta desde la ruta por defecto del equipo.
LAN_IFACE=
LAN_NETWORK=
LAN_GATEWAY=

# Descubrimiento ARP: segundos de espera y reintentos.
LAN_ARP_TIMEOUT=3
LAN_ARP_RETRY=2

# ── Escáner de dispositivos (NetworkMonitor.py) ───────────────────────────────
# Cada cuántos segundos se repite, cuántos puertos comunes revisa y tope por host.
LAN_SCAN_INTERVAL=300
LAN_SCAN_TOP_PORTS=100
LAN_SCAN_HOST_TIMEOUT=30

# ── Escáner de puertos (LanPorts.py) ──────────────────────────────────────────
LAN_PORTS_INTERVAL=1800
# fast = puertos comunes; deep = más puertos + sistema operativo + scripts NSE (más lento e intrusivo).
LAN_PORTS_MODE=fast
LAN_PORTS_FAST_TOP=200
LAN_PORTS_FAST_TIMEOUT=30
LAN_PORTS_DEEP_TOP=1000
LAN_PORTS_DEEP_TIMEOUT=60

# ── Tráfico (LanTraffic.py) ───────────────────────────────────────────────────
# Cada cuántos segundos se guarda un snapshot y cuántas conexiones/dominios incluye.
LAN_TRAFFIC_FLUSH_SECS=60
LAN_TRAFFIC_TOP_CONNECTIONS=20
LAN_TRAFFIC_TOP_DNS=30

# ── Privacidad ────────────────────────────────────────────────────────────────
# true = consulta api.macvendors.com e ip-api.com (envía tus MAC e IP de destino a terceros).
# false = solo usa la base de fabricantes local que trae nmap.
LAN_EXTERNAL_LOOKUPS=false

# ── Almacenamiento ────────────────────────────────────────────────────────────
# Minutos que se conservan los JSON crudos antes de borrarlos.
LAN_RETENTION_MIN=720

# ── Elastic ───────────────────────────────────────────────────────────────────
ELK_VERSION=8.13.0
ES_HEAP=1g

# Dirección donde se publican Elasticsearch y Kibana.
# 127.0.0.1 = solo este equipo. Elasticsearch no tiene autenticación: no lo expongas a la red.
BIND_ADDR=127.0.0.1
ES_PORT=9200
KIBANA_PORT=5601
